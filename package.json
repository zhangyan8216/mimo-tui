{
  "name": "mimo-tui",
  "version": "1.0.0",
  "description": "Terminal AI coding agent powered by Xiaomi MiMo - a CLI coding assistant",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mimo": "dist/index.js"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaomi/mimo-tui.git"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.tsx",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "cli",
    "ai",
    "terminal",
    "mimo",
    "coding-assistant",
    "anthropic",
    "tui",
    "xiaomi",
    "coding-agent",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.4.0",
    "diff": "^7.0.0",
    "glob": "^11.0.0",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "smol-toml": "^1.3.0",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/diff": "^6.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/yargs-parser": "^21.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
